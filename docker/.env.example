# Copy this file to `.env` in this same docker/ directory and adjust the values as
# needed:
#   cp docker/.env.example docker/.env
#
# docker compose automatically loads docker/.env when running commands with
# `docker compose -f docker/docker-compose.yml ...` from the project root.
# Every variable has a matching fallback default in docker-compose.yml.

# Map image, relative to scripts/
MAP_FILE=maps/simplemaze.png

# Start and goal nodes, which must be free cells of the map.
# x is the column and y is the row of the map image.
START_X=418
START_Y=0
GOAL_X=610
GOAL_Y=861

# User and group the container runs as (output of `id -u` and `id -g`)
HOST_UID=1000
HOST_GID=1000
