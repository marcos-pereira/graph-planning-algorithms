FROM python:3.12-slim

LABEL maintainer="marcos-pereira"
LABEL description="Graph planning algorithms — PixiJS web visualizer (FastAPI + uvicorn)"

# Shared library required by the OpenCV wheels
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

# Install the planner and web server Python dependencies
# (baked into the image; scripts/ and webvis/ are mounted at runtime)
COPY scripts/requirements.txt /tmp/scripts-requirements.txt
COPY webvis/requirements.txt /tmp/webvis-requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r /tmp/scripts-requirements.txt -r /tmp/webvis-requirements.txt

# /app is where webvis/ is mounted at runtime
WORKDIR /app

CMD ["uvicorn", "server:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
